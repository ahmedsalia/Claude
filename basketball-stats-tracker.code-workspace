{
  "folders": [
    {
      "name": "🏀 Basketball Stats Tracker",
      "path": "."
    },
    {
      "name": "📱 App 1 - Mobile",
      "path": "./app1-mobile"
    },
    {
      "name": "🎥 App 2 - Video Analysis",
      "path": "./app2-video-analysis"
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": true
    },
    "python.defaultInterpreterPath": "${workspaceFolder}/app2-video-analysis/venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": false,
    "python.linting.flake8Enabled": true,
    "typescript.preferences.importModuleSpecifier": "relative",
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/node_modules": true,
      "**/.expo": true,
      "**/.expo-shared": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.expo": true,
      "**/venv": true,
      "**/__pycache__": true
    }
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "msjsdiag.vscode-react-native",
      "ms-vscode.vscode-typescript-next"
    ]
  }
}
