{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "📱 Install App 1 Dependencies",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/app1-mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "📱 Start App 1 - Expo",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/app1-mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "📱 Run App 1 - Android",
      "type": "shell",
      "command": "npm run android",
      "options": {
        "cwd": "${workspaceFolder}/app1-mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📱 Run App 1 - iOS",
      "type": "shell",
      "command": "npm run ios",
      "options": {
        "cwd": "${workspaceFolder}/app1-mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📱 Clear Expo Cache",
      "type": "shell",
      "command": "npm start -- --clear",
      "options": {
        "cwd": "${workspaceFolder}/app1-mobile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🎥 Create Python Virtual Environment",
      "type": "shell",
      "command": "python3 -m venv venv",
      "options": {
        "cwd": "${workspaceFolder}/app2-video-analysis"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🎥 Install App 2 Dependencies",
      "type": "shell",
      "command": "pip install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}/app2-video-analysis"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "🎥 Run App 2 (Video Analysis)",
      "type": "shell",
      "command": "python main.py",
      "options": {
        "cwd": "${workspaceFolder}/app2-video-analysis"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "🔧 Install All Dependencies",
      "dependsOn": [
        "📱 Install App 1 Dependencies",
        "🎥 Install App 2 Dependencies"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
